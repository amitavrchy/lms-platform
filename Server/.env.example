# Server (NestJS) â€” copy to .env and fill secrets
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_platform?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Stripe (Dashboard â†’ Developers â†’ API keys). Leave blank to disable commerce.
STRIPE_SECRET_KEY=
# Optional default price used when POST /commerce/checkout has no priceId.
STRIPE_PRICE_ID=
# Set this from the Stripe webhook endpoint configured at /commerce/webhook.
STRIPE_WEBHOOK_SECRET=

AI_SERVICE_URL=http://127.0.0.1:8002
