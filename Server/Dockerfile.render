FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PGDATA=/var/lib/postgresql/data \
    POSTGRES_USER=learnora \
    POSTGRES_PASSWORD=learnora \
    POSTGRES_DB=learnora \
    PORT=10000 \
    DATABASE_URL=postgresql://learnora:learnora@127.0.0.1:5432/learnora?schema=public

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       postgresql postgresql-contrib \
       openssl ca-certificates curl gosu \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /var/run/postgresql "$PGDATA" \
  && chown -R postgres:postgres /var/run/postgresql "$PGDATA"

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --ignore-scripts

COPY . .
RUN npx prisma generate \
  && npm run build \
  && chmod +x /app/docker-entrypoint-render.sh \
  && npm prune --omit=dev

ENV NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=192

EXPOSE 10000
ENTRYPOINT ["/app/docker-entrypoint-render.sh"]